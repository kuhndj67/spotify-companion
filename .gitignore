node_modules/
dist/

# Host-side MCP server checkout (see npm run mcp:setup). Contains a credential copy.
.mcp-server/
.mcp-auth/

# Machine-local tool settings, not project configuration.
.claude/settings.local.json

# Spotify OAuth credentials and tokens — never commit.
# The whole secrets/ directory is ignored, except the committed example template.
secrets/*
!secrets/spotify-config.example.json
!secrets/musicbrainz.example.json
!secrets/metabase.example.json
spotify-config.json
.env
.env.local

# Listening history and its snapshots (U1).
#
# NOTE: this directory holds the only data in the project that cannot be regenerated. Being
# gitignored makes it invisible to git and therefore MORE exposed to `git clean -xdf`, not less.
# Snapshots live here too, so database and backups share a single deletion event. Point
# SNAPSHOT_DIR outside the project tree if that matters to you.
data/

# Rule definitions (U3). User-authored, and a fairly direct statement of listening
# preference, so it is the user's data rather than project configuration. Same shape as
# secrets/: the directory is ignored, the committed example template is not.
#
# ⚠️ This does NOT depend on the repository's visibility, and an earlier version of this
# comment said "this repository is public" — which was wrong (it is private) and, worse, was
# the kind of premise that decays silently because nothing re-tests it. The reason is that
# user-authored content does not belong in the repo on its own merits; that holds whether the
# repo is public, private, or later flipped.
config/*
!config/rules.example.json

# U5's kill switch and runaway latch (`state/automation-state.json`).
#
# Machine-local RUNTIME state, not configuration. ⚠️ A committed `globalAutomationEnabled: true`
# would arm automation on any checkout -- which is the opposite of FR-47's "off by default", and
# the one default in this project that must not travel.
#
# ⚠️ The DIRECTORY is tracked (via .gitkeep) while its contents are not, unlike `data/` where the
# whole directory is ignored. The mount needs to exist before the first `compose up`, and on a
# Linux host a directory Docker creates is owned by root -- leaving the app, which drops to
# `node`, unable to write its own kill switch.
#
# ⚠️ NOT under `data/`: restoring a week-old history backup would otherwise restore the week-old
# latch, and a kill switch a database restore can re-arm is not a kill switch.
state/*
!state/.gitkeep

*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Ops baseline for the reboot check (scripts/post-boot-check.ps1) — disposable
.boot-check-baseline.json
