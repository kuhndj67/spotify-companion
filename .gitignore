node_modules/
dist/

# Host-side MCP server checkout (see npm run mcp:setup). Contains a credential copy.
.mcp-server/
.mcp-auth/

# Machine-local tool settings, not project configuration.
.claude/settings.local.json

# Spotify OAuth credentials and tokens — never commit.
# The whole secrets/ directory is ignored, except the committed example template.
secrets/*
!secrets/spotify-config.example.json
!secrets/musicbrainz.example.json
spotify-config.json
.env
.env.local

# Listening history and its snapshots (U1).
#
# NOTE: this directory holds the only data in the project that cannot be regenerated. Being
# gitignored makes it invisible to git and therefore MORE exposed to `git clean -xdf`, not less.
# Snapshots live here too, so database and backups share a single deletion event. Point
# SNAPSHOT_DIR outside the project tree if that matters to you.
data/

# Rule definitions (U3). User-authored, and a fairly direct statement of listening
# preference — this repository is public. Same shape as secrets/: the directory is
# ignored, the committed example template is not.
config/*
!config/rules.example.json

*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Ops baseline for the reboot check (scripts/post-boot-check.ps1) — disposable
.boot-check-baseline.json
