{
  "name": "spotify-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local containerised web app that displays and enriches the currently playing Spotify track, via an MCP server and the Spotify Web API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "auth": "node scripts/auth.mjs",
    "mcp:setup": "node scripts/mcp-setup.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
