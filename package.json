{
  "name": "spotify-companion",
  "version": "0.8.3",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Local containerised web app that displays and enriches the currently playing Spotify track, via an MCP server and the Spotify Web API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "auth": "node scripts/auth.mjs",
    "rules:init": "node scripts/rules-init.mjs",
    "mcp:setup": "node scripts/mcp-setup.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "smoke": "node scripts/smoke-entry-points.mjs",
    "knip": "knip",
    "verify": "npm run typecheck && npm test && npm run smoke && npm run knip",
    "check:rules-schema": "node --import tsx scripts/check-rules-schema.mjs",
    "reporting:build": "node --import tsx scripts/build-reporting-db.mjs",
    "reclassify": "node --import tsx scripts/reclassify-unobserved-tails.mjs",
    "repair:skip-source": "node --import tsx scripts/repair-skip-source.mjs",
    "db:backup": "node --import tsx scripts/backup-history.mjs",
    "db:restore": "node --import tsx scripts/restore-history.mjs",
    "db:verify-backups": "node --import tsx scripts/verify-all-backups.mjs",
    "verify:up": "node scripts/verify-install.mjs up",
    "verify:down": "node scripts/verify-install.mjs down",
    "protect": "node scripts/protect.mjs",
    "release": "node --import tsx scripts/release.mjs",
    "reporting:credits": "node scripts/resolve-artist-credits.mjs",
    "reporting:metabase": "node scripts/metabase-setup.mjs",
    "reporting:refresh": "npm run reporting:credits && npm run reporting:build",
    "reporting:report": "node scripts/metabase-report.mjs",
    "probe:p-u5-1:rehearse": "node scripts/probe-p-u5-1.mjs --rehearse",
    "probe:p-u5-1": "node scripts/probe-p-u5-1.mjs",
    "probe:p-u5-1:mark": "node scripts/probe-p-u5-1-mark.mjs",
    "probe:p-u5-1:analyse": "node scripts/probe-p-u5-1-analyse.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "tar": "7.5.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "ajv": "^8.20.0",
    "fast-check": "^4.9.0",
    "knip": "^6.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
