{
  // The build config compiles src/ only, so test files were never typechecked.
  // `npm run typecheck` uses this one to cover both.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // rootDir is src/ for the build; widen it here so test/ is in the program too.
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
